{
    "name": "hus-language",
    "displayName": "Hus Language",
    "description": "Hus Language support for Visual Studio Code",
    "version": "1.1.0",
    "publisher": "Hus-Lang",
    "engines": {
        "vscode": "^1.80.0"
    },

    "contributes": {
        "languages": [{
            "id": "hus",
            "aliases": ["Hus","hus"],
            "extensions": [".hus",".husl"],
            "configuration": "./language-configuration.json"
        }],
        
    "grammars": [{
        "language": "hus",
        "scopeName": "source.hus",
        "path": "./syntax/hus-tmLanguage.json"
        }]
        
    }

}