{
  "scopeName": "source.hus",
  "fileTypes": ["hus"],
  "patterns": [
    {
      "name": "comment.line.number-sign.hus",
      "match": "#.*$"
    },
    {
      "name": "string.hus",
      "match": "\"[^\"]*\"|'[^']*'"
    },
    {
      "name": "keyword.control.hus",
      "match": "\\b(print|set)\\b"
    },
    {
      "name": "variable.other.hus",
      "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b"
    }
  ]
}